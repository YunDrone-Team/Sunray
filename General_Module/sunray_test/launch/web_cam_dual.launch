<launch>
  <arg name="image_view" default="false" />
  <arg name="camera_profile" default="common" />
  <arg name="front_video_device" default="/dev/video2" />
  <arg name="down_video_device" default="/dev/video0" />
  <arg name="front_start_delay_s" default="2.0" />
  <arg name="down_start_delay_s" default="1.0" />
  <arg name="camera_post_clean_delay_s" default="0.5" />
  <arg name="camera_warmup_frames" default="5" />
  <arg name="camera_watchdog" default="true" />
  <arg name="camera_watchdog_stale_timeout_s" default="3.0" />
  <arg name="camera_watchdog_restart_cooldown_s" default="12.0" />
  <arg name="camera_watchdog_black_mean_threshold" default="25.0" />
  <arg name="camera_watchdog_black_dynamic_range_threshold" default="8" />
  <arg name="camera_watchdog_black_consecutive_frames" default="30" />

  <node name="web_cam_front" pkg="web_cam" type="web_cam_node" output="screen" respawn="true" respawn_delay="1.0"
        launch-prefix="rosrun sunray_test camera_launch_guard.py --role front --node-name /web_cam_front --device $(arg front_video_device) --peer-device $(arg down_video_device) --startup-delay $(arg front_start_delay_s) --post-clean-delay $(arg camera_post_clean_delay_s) --warmup-frames $(arg camera_warmup_frames) --">
    <rosparam command="load" file="$(find sunray_test)/config/cameras/$(arg camera_profile)/front_cam.yml"/>
    <param name="video_device" value="$(arg front_video_device)" />
  </node>

  <node name="web_cam" pkg="web_cam" type="web_cam_node" output="screen" respawn="true" respawn_delay="1.0"
        launch-prefix="rosrun sunray_test camera_launch_guard.py --role down --node-name /web_cam --device $(arg down_video_device) --peer-device $(arg front_video_device) --startup-delay $(arg down_start_delay_s) --post-clean-delay $(arg camera_post_clean_delay_s) --warmup-frames $(arg camera_warmup_frames) --">
    <rosparam command="load" file="$(find sunray_test)/config/cameras/$(arg camera_profile)/down_cam.yml"/>
    <param name="video_device" value="$(arg down_video_device)" />
  </node>

  <node if="$(arg image_view)" name="image_view" pkg="image_view" type="image_view" respawn="false" output="screen">
    <remap from="image" to="/web_cam/image_raw"/>
    <param name="autosize" value="true" />
  </node>

  <node if="$(arg image_view)" name="view2" pkg="image_view" type="image_view" output="screen">
    <remap from="image" to="/web_cam_front/image_raw"/>
  </node>

  <node if="$(arg camera_watchdog)" name="camera_watchdog" pkg="sunray_test" type="camera_watchdog.py" output="screen"
        args="--roles front,down --nodes /web_cam_front,/web_cam --topics /web_cam_front/image_raw,/web_cam/image_raw --stale-timeout $(arg camera_watchdog_stale_timeout_s) --restart-cooldown $(arg camera_watchdog_restart_cooldown_s) --black-mean-threshold $(arg camera_watchdog_black_mean_threshold) --black-dynamic-range-threshold $(arg camera_watchdog_black_dynamic_range_threshold) --black-consecutive-frames $(arg camera_watchdog_black_consecutive_frames)" />



</launch>
